<Project>
  <!-- The source under src/ is exported from wc3ctl (scripts/export-wc3-mcp.py there) and is never
       edited here. This file is what makes that same source this product: the exe is wc3-mcp, it
       registers in AI apps as "wc3" and backs up their configs as NAME.wc3-mcp.bak. The version
       is the one the release tag must match. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Wc3.Mcp'">
    <AssemblyName>wc3-mcp</AssemblyName>
    <RootNamespace>Wc3.Mcp</RootNamespace>
    <Version>0.5.2</Version>
    <McpProductId>wc3-mcp</McpProductId>
    <McpServerName>wc3</McpServerName>
  </PropertyGroup>

  <!-- Build stamp: bake the git short hash and the UTC build time into assembly metadata for every
       project, so the MCP version_info tool reports them instead of the "nogit" and "unknown"
       fallbacks. git is best-effort (ContinueOnError) so a build still works without it on PATH. -->
  <Target Name="StampBuildInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardErrorImportance="low" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHash" />
    </Exec>
    <PropertyGroup>
      <_GitHash Condition="'$(_GitHash)' == ''">nogit</_GitHash>
      <_BuildTimeUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm"))</_BuildTimeUtc>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitHash" Value="$(_GitHash.Trim())" />
      <AssemblyMetadata Include="BuildTimeUtc" Value="$(_BuildTimeUtc)" />
    </ItemGroup>
  </Target>
</Project>
