<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The command people type and every AI app starts. The namespace stays Wc3.Mcp. -->
    <AssemblyName>wc3-mcp</AssemblyName>
    <RootNamespace>Wc3.Mcp</RootNamespace>
    <Version>0.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wc3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official MCP C# SDK (stable). Its Microsoft.Extensions.* transitives stay
         isolated to this exe — never add them to the version-pinned projects. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wc3.Commands\Wc3.Commands.csproj" />
  </ItemGroup>

</Project>
